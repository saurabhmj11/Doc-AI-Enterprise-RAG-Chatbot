# Ultra Doc-Intelligence Environment Variables
# RAG Chatbot Challenge Configuration

# LLM Configuration
# Options: 'online' (Gemini), 'offline' (Ollama), or 'oss' (Extractive fallback with open-source models)
LLM_MODE=online
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-flash-latest

# Local Ollama Settings (Optional free open-source LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Open-Source Embedding Configuration (Default: Free sentence-transformers)
EMBEDDING_MODE=oss
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document Processing & OCR Settings
MAX_FILE_SIZE_MB=50
ENABLE_OCR=true
OCR_LANGUAGE=eng
CHUNK_SIZE=800
CHUNK_OVERLAP=120
USE_TOKEN_CHUNKING=true

# Hybrid Retrieval Settings (Dense + BM25 Sparse + Reciprocal Rank Fusion)
ENABLE_HYBRID_SEARCH=true
HYBRID_FUSION_STRATEGY=rrf
HYBRID_RRF_K=60
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5
SIMILARITY_THRESHOLD=0.15

# Neural Cross-Encoder Reranking
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32

# Confidence & Guardrail Thresholds
HIGH_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_THRESHOLD=0.35
GROUNDING_COVERAGE_THRESHOLD=0.6

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# =====================================================
# Large-corpus RAG engine (backend/rag, routes /api/rag/*)
# All keys use the RAG_ prefix so they never clash with the settings above.
# =====================================================
# LLM: auto = Groq when GROQ_API_KEY is set, otherwise local Ollama
GROQ_API_KEY=
RAG_LLM_PROVIDER=auto
RAG_GROQ_MODEL=llama-3.1-8b-instant
RAG_OLLAMA_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen2.5:3b
RAG_LLM_MAX_TOKENS=350

# Retrieval
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=16
RAG_TOP_K_CONTEXT=5
RAG_HNSW_EF_SEARCH=100

# Ingestion
RAG_CHUNK_TOKENS=500
RAG_CHUNK_OVERLAP=75
RAG_OCR_ENABLED=true
# auto = Tesseract if on PATH, else RapidOCR (pip-only, ONNX)
RAG_OCR_ENGINE=auto
